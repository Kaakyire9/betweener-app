+
+TEST(DefaultEncryptionManager, UnframedDropsEveryTrackBeforeAndAfterKeySetup) {
+  using Track = FrameCryptorTransformer::TrackType;
+  for (auto track : {Track::kAudio, Track::kVideo, Track::kScreenshare,
+                     Track::kScreenshareAudio}) {
+    auto manager = make_ref_counted<DefaultEncryptionManager>();
+    auto observer = make_ref_counted<RecordingManagerObserver>();
+    manager->SetObserver(observer);
+    auto payload = ParseHex("78aabbccdd");
+    auto in = track == Track::kAudio || track == Track::kScreenshareAudio
+                  ? MakeAudioInput("p", payload, 1, track)
+                  : MakeVideoInput("p", payload, kVideoCodecVP8, true, 2, track);
+    for (bool keyed : {false, true}) {
+      if (keyed) {
+        ASSERT_TRUE(manager->SetKeyWithIvPrefix("p", 0, kJsKey, kJsPrefix));
+      }
+      for (int attempt = 0; attempt < 3; ++attempt) {
+        Buffer out(payload.data(), payload.size());
+        FrameCryptionState state = kOk;
+        EXPECT_FALSE(manager->Decrypt(in, out, &state));
+        EXPECT_EQ(out.size(), 0u);
+        EXPECT_EQ(state, kUnencrypted);
+      }
+    }
+    EXPECT_TRUE(HasEvent(observer->Take(),
+                        DefaultEncryptionManager::E2eeEventType::kUnencryptedFrame));
+  }
+}
+
+TEST(DefaultEncryptionManager, StrictUnframedDropDoesNotPoisonAes256RoundTrip) {
+  auto manager = make_ref_counted<DefaultEncryptionManager>(
+      DefaultEncryptionManager::Cipher::kAes256Gcm);
+  std::vector<uint8_t> key(32, 0x42);
+  ASSERT_TRUE(manager->SetKeyWithIvPrefix("p", 0, key, kJsPrefix));
+  auto payload = ParseHex("78aabbccdd");
+  auto in = MakeAudioInput("p", payload);
+  Buffer out;
+  FrameCryptionState state = kNew;
+  EXPECT_FALSE(manager->Decrypt(in, out, &state));
+  Buffer encrypted;
+  ASSERT_TRUE(manager->Encrypt(in, encrypted, &state));
+  in.data = encrypted;
+  ASSERT_TRUE(manager->Decrypt(in, out, &state));
+  EXPECT_EQ(std::vector<uint8_t>(out.begin(), out.end()), payload);
 }
 
