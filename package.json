{
  "name": "betweener-app",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "overrides": {
    "expo-notification-service-extension-plugin": {
      "@expo/image-utils": {
        "semver": "^7.8.5"
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "postinstall": "patch-package",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:expo": "expo lint",
    "test:rn": "node --no-deprecation ./node_modules/jest/bin/jest.js --runInBand --config jest.config.js",
    "test:chat-logic": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test __tests__/chat-message-mappers.regression.test.ts __tests__/chat-thread-behavior.regression.test.ts __tests__/chat-message-state.regression.test.ts __tests__/chat-message-actions.regression.test.ts __tests__/chat-message-list-reconciliation.regression.test.ts __tests__/chat-list-message-merge.regression.test.ts __tests__/chat-list-enrichment-plan.regression.test.ts __tests__/chat-db-lock-policy.regression.test.ts __tests__/chat-presence.regression.test.ts __tests__/chat-media-album.regression.test.ts __tests__/chat-media-access.regression.test.ts __tests__/chat-attachment-metadata.regression.test.ts __tests__/chat-attachment-queue.regression.test.ts __tests__/chat-attachment-state.regression.test.ts __tests__/chat-attachment-production-hardening.regression.test.ts __tests__/chat-upload-policy.regression.test.ts __tests__/chat-upload-error-policy.regression.test.ts __tests__/chat-media-download-policy.regression.test.ts __tests__/chat-voice-recording.regression.test.ts __tests__/view-once-attachment.regression.test.ts __tests__/view-once-send-service.regression.test.ts",
    "test:vibes-logic": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test __tests__/location-display.regression.test.ts __tests__/profile-location-update.regression.test.ts __tests__/vibes-discovery.regression.test.ts __tests__/reanimated-animation-safety.regression.test.ts __tests__/react-native-fabric-animation-patch.regression.test.ts",
    "test:liveness-logic": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test __tests__/liveness-engine.regression.test.ts",
    "test:live-logic": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test __tests__/live-domain.regression.test.ts __tests__/live-database-foundation.regression.test.ts __tests__/live-phase2-public-beta.regression.test.ts __tests__/live-media-provider.regression.test.ts __tests__/stream-live-media-provider.regression.test.ts __tests__/live-native-config.regression.test.ts __tests__/live-rtc-token.regression.test.ts __tests__/circle-access.regression.test.ts",
    "test:logic": "npm run test:chat-logic && npm run test:vibes-logic && npm run test:liveness-logic && npm run test:live-logic",
    "test:all": "npm run test:rn && npm run test:logic",
    "assets:optimize:onboarding": "node ./scripts/optimize-onboarding-assets.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "supabase:types": "python ./scripts/supabase_gen_types.py",
    "supabase:types:check": "python ./scripts/supabase_gen_types.py --check"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/metro-runtime": "~57.0.9",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@stream-io/react-native-webrtc": "145.3.0",
    "@stream-io/video-react-native-sdk": "1.43.0",
    "@supabase/supabase-js": "^2.110.7",
    "expo": "~57.0.12",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.3",
    "expo-auth-session": "~57.0.6",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.10",
    "expo-calendar": "~57.0.1",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.10",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.11",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-manipulator": "~57.0.9",
    "expo-image-picker": "~57.0.9",
    "expo-intent-launcher": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-location": "~57.0.9",
    "expo-notification-service-extension-plugin": "1.0.2",
    "expo-notifications": "~57.0.10",
    "expo-router": "~57.0.12",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.13",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "lucide-react-native": "^0.544.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-compressor": "2.0.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "0.36.1",
    "react-native-purchases": "^10.4.3",
    "react-native-purchases-ui": "^10.4.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^5.1.1",
    "react-native-vision-camera-face-detector": "^2.0.6",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tus-js-client": "^4.3.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@jest/globals": "^30.4.1",
    "@react-native/jest-preset": "0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "babel-jest": "^30.4.1",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~57.0.0",
    "baseline-browser-mapping": "^2.10.43",
    "eslint": "^10.7.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "patch-package": "^8.0.1",
    "react-refresh": "^0.14.2",
    "sharp": "^0.35.3",
    "supabase": "2.109.1",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-compressor",
          "react-native-nitro-image"
        ]
      }
    }
  },
  "private": true,
  "allowScripts": {
    "@sentry/cli@2.58.4": true,
    "unrs-resolver@1.12.2": true
  }
}
