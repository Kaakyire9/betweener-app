{
  "name": "@betweener/program-compositor-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint bin lib test",
    "format:check": "prettier --check .",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run build && npm run lint && npm run format:check && npm test",
    "synth": "cdk synth --strict",
    "diff": "cdk diff"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.274.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "aws-cdk": "2.1146.1",
    "eslint": "^10.13.0",
    "eslint-plugin-awscdk": "^4.4.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
