diff --git a/ops/local-supabase/tests/vector-docker-api-proxy/probe-docker-api.sh b/ops/local-supabase/tests/vector-docker-api-proxy/probe-docker-api.sh
--- a/ops/local-supabase/tests/vector-docker-api-proxy/probe-docker-api.sh
+++ b/ops/local-supabase/tests/vector-docker-api-proxy/probe-docker-api.sh
@@
 set -eu
+
+docker_socket_path="${DOCKER_SOCKET_PATH:-/var/run/docker.sock}"
@@
         printf 'GET %s HTTP/1.1\r\nHost: docker\r\nConnection: close\r\n\r\n' "$endpoint" |
-            timeout 5 socat - UNIX-CONNECT:/var/run/docker.sock |
+            timeout 5 socat -T 4 STDIO,ignoreeof UNIX-CONNECT:"$docker_socket_path" |
             tr -d '\r'
@@
-    printf '%s\n' "$response" | sed '1,/^$/d'
+    headers="$(printf '%s\n' "$response" | sed -n '1,/^$/p')"
+    body="$(printf '%s\n' "$response" | sed '1,/^$/d')"
+    if printf '%s\n' "$headers" | grep -Eiq '^Transfer-Encoding:[[:space:]]*chunked[[:space:]]*$'; then
+        body="$(printf '%s\n' "$body" | sed -E '/^[0-9A-Fa-f]+(;.*)?$/d' | tr -d '\n')"
+    fi
+    printf '%s\n' "$body"
 }
@@
-    printf '%s' "$body" | sed -n "s/.*\"${key}\":\"\([^\"]*\)\".*/\1/p" | sed -n '1p'
+    printf '%s' "$body" | awk -v wanted="$key" '
+        {
+            for (i = 1; i <= length($0); i++) {
+                c = substr($0, i, 1)
+
+                if (in_string) {
+                    if (escaped) {
+                        token = token c
+                        escaped = 0
+                    } else if (c == "\\") {
+                        escaped = 1
+                    } else if (c == "\"") {
+                        in_string = 0
+                        if (role == "key") {
+                            current_key = token
+                            expect_key = 0
+                        } else if (role == "target") {
+                            print token
+                            found = 1
+                            exit
+                        } else if (role == "value") {
+                            expect_value = 0
+                        }
+                    } else {
+                        token = token c
+                    }
+                    continue
+                }
+
+                if (c == "{" || c == "[") {
+                    depth++
+                    if (depth == 1) expect_key = 1
+                } else if (c == "}" || c == "]") {
+                    depth--
+                } else if (depth == 1 && c == ",") {
+                    expect_key = 1
+                    expect_value = 0
+                    current_key = ""
+                } else if (depth == 1 && c == ":") {
+                    expect_value = 1
+                } else if (depth == 1 && c == "\"") {
+                    in_string = 1
+                    escaped = 0
+                    token = ""
+                    if (expect_key) role = "key"
+                    else if (expect_value && current_key == wanted) role = "target"
+                    else role = "value"
+                }
+            }
+        }
+        END {
+            if (!found) exit 1
+        }
+    '
 }

diff --git a/ops/local-supabase/tests/vector-docker-api-proxy/run-tests.ps1 b/ops/local-supabase/tests/vector-docker-api-proxy/run-tests.ps1
--- a/ops/local-supabase/tests/vector-docker-api-proxy/run-tests.ps1
+++ b/ops/local-supabase/tests/vector-docker-api-proxy/run-tests.ps1
@@
-    $startInfo.Arguments = "--context $DockerContext exec -i $ProxyName socat -T 5 STDIO TCP:127.0.0.1:2375"
+    $startInfo.Arguments = "--context $DockerContext exec -i $ProxyName socat -T 5 STDIO,ignoreeof TCP:127.0.0.1:2375"
